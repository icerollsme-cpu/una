# ── Kimi K2 via NVIDIA NIM (required) ────────────────────────────────────────
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Model to use (default is Kimi K2 Instruct)
KIMI_MODEL=moonshotai/kimi-k2-instruct

# ── SerpAPI (required for SERP analysis) ─────────────────────────────────────
SERPAPI_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── scrape.do (primary page scraper) ─────────────────────────────────────────
SCRAPE_DO_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── scrapestack (fallback page scraper) ──────────────────────────────────────
SCRAPESTACK_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── ScrapeGraphAI (AI-powered competitor content extraction) ──────────────────
SCRAPEGRAPHAI_KEY=sgai-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ═══════════════════════════════════════════════════════════════════════════════
# SOCIAL MEDIA POSTING (social_poster.py)
# Login-only — no API keys, no developer portals, no paid services.
# Fill in only the platforms you want to post to.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Bluesky ───────────────────────────────────────────────────────────────────
# No registration needed. In your Bluesky account go to:
#   Settings → Privacy and Security → App Passwords → Add App Password
# This is just a scoped password — NOT an API key.
BLUESKY_HANDLE=yourhandle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Mastodon ──────────────────────────────────────────────────────────────────
# No pre-registration needed. The code registers its own app on the instance
# automatically on first run using Mastodon.create_app().
# Just provide your instance URL, email, and password.
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_EMAIL=you@example.com
MASTODON_PASSWORD=your_mastodon_password

# ── Twitter / X ───────────────────────────────────────────────────────────────
# Uses twikit (unofficial cookie-based session — no API key required).
# Provide your normal login credentials.
TWITTER_USERNAME=your_twitter_username
TWITTER_EMAIL=you@example.com
TWITTER_PASSWORD=your_twitter_password

# ── Instagram ─────────────────────────────────────────────────────────────────
# Uses instagrapi (unofficial private mobile API — no API key required).
# Provide your normal Instagram login credentials.
# Note: Instagram feed posts always require an image or video.
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# ── Threads ───────────────────────────────────────────────────────────────────
# Uses threads-net (unofficial — no API key required).
# Shares the same Instagram credentials above — no extra setup.
# (INSTAGRAM_USERNAME and INSTAGRAM_PASSWORD are reused for Threads)

# ── Reddit ────────────────────────────────────────────────────────────────────
# No API registration. No app creation. No client_id or client_secret.
# Logs in via old.reddit.com/api/login (cookie session + modhash), then
# submits via reddit.com/api/submit — just your normal login credentials.
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
# Default subreddit used when --subreddit is not passed on the CLI
REDDIT_DEFAULT_SUBREDDIT=test

# ── LinkedIn ──────────────────────────────────────────────────────────────────
# Uses linkedin-api (unofficial, email + password).
# No API registration. The library logs in with your normal credentials and
# then posts via LinkedIn's internal voyager/ugcPosts endpoint.
LINKEDIN_EMAIL=you@example.com
LINKEDIN_PASSWORD=your_linkedin_password

# ── TikTok ────────────────────────────────────────────────────────────────────
# Uses tiktok-uploader (Selenium-based, no API registration).
# Logs in with your normal TikTok email and password via a headless browser.
# Requires: Chrome (or Firefox) + matching chromedriver (or geckodriver) installed.
TIKTOK_EMAIL=you@example.com
TIKTOK_PASSWORD=your_tiktok_password
# Browser to use: "chrome" (default) or "firefox"
TIKTOK_BROWSER=chrome

# ═══════════════════════════════════════════════════════════════════════════════
# CONTENT PIPELINE (scraper_agent.py + content_agent.py + orchestrator.py)
# ═══════════════════════════════════════════════════════════════════════════════

# Directory where generated content files are saved (default: output/content)
CONTENT_OUTPUT_DIR=output/content

# NOTE: scraper_agent.py reuses the social platform credentials above for
# scraping (INSTAGRAM_USERNAME/PASSWORD for Instagram, TWITTER_* for Twitter,
# BLUESKY_* for Bluesky). Reddit scraping needs no login — it uses the public
# JSON API. YouTube scraping via yt-dlp also needs no credentials.
