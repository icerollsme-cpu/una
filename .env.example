# ── Kimi K2 via NVIDIA NIM (required) ────────────────────────────────────────
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Model to use (default is Kimi K2 Instruct)
KIMI_MODEL=moonshotai/kimi-k2-instruct

# ── SerpAPI (required for SERP analysis) ─────────────────────────────────────
SERPAPI_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── scrape.do (primary page scraper) ─────────────────────────────────────────
SCRAPE_DO_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── scrapestack (fallback page scraper) ──────────────────────────────────────
SCRAPESTACK_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── ScrapeGraphAI (AI-powered competitor content extraction) ──────────────────
SCRAPEGRAPHAI_KEY=sgai-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ═══════════════════════════════════════════════════════════════════════════════
# SOCIAL MEDIA POSTING (social_poster.py)
# Only fill in the platforms you intend to use — all are optional.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Bluesky / AT Protocol ─────────────────────────────────────────────────────
# Completely free. No approval. Create an App Password at:
#   https://bsky.app/settings/app-passwords
BLUESKY_HANDLE=yourhandle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Mastodon ──────────────────────────────────────────────────────────────────
# Fully free, open source. Register your app at your instance, e.g.:
#   https://mastodon.social/settings/applications
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── X / Twitter ───────────────────────────────────────────────────────────────
# Free tier: 500 tweets/month. Create an app at https://developer.x.com
# Enable OAuth 1.0a and generate Access Token + Secret under "Keys and Tokens".
TWITTER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxx
TWITTER_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWITTER_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWITTER_ACCESS_TOKEN_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Reddit ────────────────────────────────────────────────────────────────────
# Free for non-commercial use. Create a "script" app at:
#   https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx
REDDIT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
REDDIT_USER_AGENT=una-social-poster/1.0

# ── LinkedIn ──────────────────────────────────────────────────────────────────
# Free with "Share on LinkedIn" product (requires LinkedIn approval).
# Obtain tokens via OAuth 2.0 flow: https://learn.microsoft.com/en-us/linkedin/
# LINKEDIN_PERSON_ID is the numeric ID from the /v2/userinfo endpoint.
LINKEDIN_ACCESS_TOKEN=AQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LINKEDIN_PERSON_ID=xxxxxxx
# Optional: post to a company/organization page instead of personal profile
# LINKEDIN_ORG_ID=xxxxxxx

# ── Facebook Page ─────────────────────────────────────────────────────────────
# Free with App Review. Get a long-lived Page Access Token from Graph API Explorer:
#   https://developers.facebook.com/tools/explorer/
FACEBOOK_PAGE_ID=000000000000000
FACEBOOK_PAGE_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Instagram ─────────────────────────────────────────────────────────────────
# Free with App Review. Requires Business/Creator account linked to a Facebook Page.
# INSTAGRAM_ACCOUNT_ID is your IG User ID (not username), from Graph API.
INSTAGRAM_ACCOUNT_ID=000000000000000
INSTAGRAM_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Threads ───────────────────────────────────────────────────────────────────
# Completely free; 250 posts/day. Requires Meta App Review for production.
# https://developers.facebook.com/docs/threads/get-started
THREADS_USER_ID=000000000000000
THREADS_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
